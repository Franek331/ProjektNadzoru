<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:converters="clr-namespace:CarSearch.Converters"
             xmlns:local="clr-namespace:CarSearch"
             x:Class="CarSearch.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
            <converters:NotNullConverter x:Key="NotNullConverter"/>
            <converters:NotNullOrEmptyConverter x:Key="NotNullOrEmptyConverter"/>

            <!-- COLORS -->
            <Color x:Key="BgColor">#080c10</Color>
            <Color x:Key="Bg2Color">#0d1117</Color>
            <Color x:Key="PanelColor">#0f1923</Color>
            <Color x:Key="BorderColor">#1e3a4a</Color>
            <Color x:Key="AccentColor">#00d4ff</Color>
            <Color x:Key="GreenColor">#00ff88</Color>
            <Color x:Key="RedColor">#ff3344</Color>
            <Color x:Key="OrangeColor">#ff9900</Color>
            <Color x:Key="TextColor">#c8dce8</Color>
            <Color x:Key="Text2Color">#7a9aac</Color>
            <Color x:Key="Text3Color">#3a5a6a</Color>

        </ResourceDictionary>
    </Application.Resources>
</Application>
